# === Discord 必填 ===
# 使用 boss-raid-bot 原本那個 Discord Application 的 token
TOKEN=你的_discord_bot_token

# === 會員管理系統（/warn /kick /ban /mute ...）需要 ===
# 有這些身分組的成員才能使用管理指令（有「系統管理員」權限的人也可以）
# 多個伺服器時用逗號分隔，例如 ADMIN_ROLE_IDS=111,222（舊的 ADMIN_ROLE_ID 仍可使用）
ADMIN_ROLE_IDS=

# === 多伺服器資料遷移（可選） ===
# 舊版的警告 / 婚姻資料沒有區分伺服器，啟動時會自動歸到這個伺服器 ID
# 機器人只在一個伺服器時可以不填，會自動判斷
LEGACY_GUILD_ID=

# === Render / Keep-alive（可選） ===
PORT=3000
RENDER_EXTERNAL_URL=
